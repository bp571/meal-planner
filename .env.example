# Copy this file to .env and fill in what you need. Never commit .env.

# Only needed if you are not logged in to Claude Code on this machine.
ANTHROPIC_API_KEY=

# Optional: Notion integration token for importing recipes.
NOTION_TOKEN=

# Optional: model alias or id. Default: sonnet
MEAL_PLANNER_MODEL=

# Optional: port of the local web UI. Default: 8000
MEAL_PLANNER_PORT=
